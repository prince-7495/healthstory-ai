# HealthStory AI — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored;
# this template contains placeholders only.
#
# DEPLOYMENT NOTE: For Vercel production deployment, you MUST use a hosted PostgreSQL
# (e.g., Neon, Supabase, Railway, Supabase, PlanetScale). Localhost databases will NOT work.

# ---- Database (Prisma / PostgreSQL) ----
# Development: local PostgreSQL instance
# Production:  Hosted PostgreSQL (Neon, Supabase, Railway, etc.)
#   Example: postgresql://user:pass@ep-xyz.us-east-1.aws.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/healthstory"

# ---- Session signing ----
# Secret used to sign session JWTs (HS256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The code falls back to a development-only default when unset —
# set an explicit value before any real deployment.
AUTH_SECRET=""

# ---- AI Provider (xAI / Grok / Groq) --------------------------------
# Set AI_PROVIDER and paste your key to enable real AI.
# Leave AI_API_KEY empty to run in safe demo/mock mode (no external calls).
# Never commit a real key — .env is git-ignored, this file is not.
#
# xAI (Grok):  https://console.x.ai         AI_PROVIDER=xai   AI_BASE_URL=https://api.x.ai/v1
# Groq Cloud:  https://console.groq.com      AI_PROVIDER=groq  AI_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:      https://platform.openai.com   AI_PROVIDER=openai (default base URL)
#
AI_PROVIDER=groq
AI_API_KEY=          # <-- Paste your Groq API key here (get one at https://console.groq.com)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=60000

# ---- Resource limits (optional overrides; defaults in src/lib/security/limits.ts) ----
# LIMIT_REQUEST_BYTES=1048576
# LIMIT_UPLOAD_BYTES=6291456
# LIMIT_FILE_BYTES=4194304
# LIMIT_TEXT_LENGTH=50000
# LIMIT_EVENTS_PER_STORY=500
# LIMIT_QUESTIONS_PER_STORY=100
# LIMIT_FOLLOW_UPS_PER_STORY=200
# LIMIT_DOCUMENTS_PER_STORY=50

# ---- Rate limits (optional overrides; defaults in src/lib/security/rateLimit.ts) ----
# RATE_LOGIN_LIMIT=10
# RATE_LOGIN_WINDOW_MS=300000
# RATE_REGISTER_LIMIT=10
# RATE_REGISTER_WINDOW_MS=60000
# RATE_AI_LIMIT=20
# RATE_AI_WINDOW_MS=60000
# RATE_UPLOAD_LIMIT=20
# RATE_UPLOAD_WINDOW_MS=600000
# RATE_WRITE_LIMIT=120
# RATE_WRITE_WINDOW_MS=60000

# ---- Private file storage (optional; defaults to ./storage) ----
# STORAGE_DIR="./storage"

# ---- Vercel Blob Storage (for file uploads in production) ----
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ---- Upstash Redis (for distributed rate limiting in production) ----
# Get your URL and token at https://console.upstash.com/redis
# Free tier available. Works with Vercel serverless.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ---- Resource limits (optional overrides; defaults in src/lib/security/limits.ts) ----
# LIMIT_REQUEST_BYTES=1048576
# LIMIT_UPLOAD_BYTES=6291456
# LIMIT_FILE_BYTES=4194304
# LIMIT_TEXT_LENGTH=50000
# LIMIT_EVENTS_PER_STORY=500
# LIMIT_QUESTIONS_PER_STORY=100
# LIMIT_FOLLOW_UPS_PER_STORY=200
# LIMIT_DOCUMENTS_PER_STORY=50

# ---- Rate limits (optional overrides; defaults in src/lib/security/rateLimit.ts) ----
# RATE_LOGIN_LIMIT=10
# RATE_LOGIN_WINDOW_MS=300000
# RATE_REGISTER_LIMIT=10
# RATE_REGISTER_WINDOW_MS=60000
# RATE_AI_LIMIT=20
# RATE_AI_WINDOW_MS=60000
# RATE_UPLOAD_LIMIT=20
# RATE_UPLOAD_WINDOW_MS=600000
# RATE_WRITE_LIMIT=120
# RATE_WRITE_WINDOW_MS=60000

# ---- Private file storage (optional; defaults to ./storage) ----
# STORAGE_DIR="./storage"
